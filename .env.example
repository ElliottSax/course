# Course Platform Environment Variables
# Copy this file to .env.local and fill in your values

# ==========================================
# Database (Supabase)
# ==========================================
# Get these from your Supabase project settings
# Project Settings > API > Project URL and API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct database connection string
# Project Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ==========================================
# Authentication (NextAuth.js)
# ==========================================
# URL where your app is hosted
NEXTAUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# Google OAuth (optional)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (optional)
# Get from: https://github.com/settings/developers
GITHUB_ID=your-github-client-id
GITHUB_SECRET=your-github-client-secret

# ==========================================
# Payments (Stripe)
# ==========================================
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Webhook secret for local development
# Get by running: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ==========================================
# AI (OpenAI)
# ==========================================
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: Organization ID
OPENAI_ORG_ID=org-your-org-id

# ==========================================
# Vector Database (Pinecone)
# ==========================================
# Get from: https://app.pinecone.io
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-environment
PINECONE_INDEX=course-content

# ==========================================
# Email (Resend - Optional)
# ==========================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ==========================================
# File Storage & CDN
# ==========================================
# Supabase Storage (included with Supabase)
NEXT_PUBLIC_SUPABASE_STORAGE_URL=https://your-project.supabase.co/storage/v1

# Optional: External CDN (Cloudflare R2, AWS S3, etc.)
# CDN_URL=https://cdn.yourdomain.com

# ==========================================
# Video Processing
# ==========================================
# FFmpeg path (usually auto-detected)
# FFMPEG_PATH=/usr/bin/ffmpeg

# Video processing queue (optional - for background jobs)
# REDIS_URL=redis://localhost:6379

# ==========================================
# Analytics (Optional)
# ==========================================
# Google Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# PostHog (optional)
# NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ==========================================
# Monitoring (Optional)
# ==========================================
# Sentry (error tracking)
# SENTRY_DSN=https://your-dsn@sentry.io/project-id

# LogRocket (session replay)
# LOGROCKET_APP_ID=your-app/id

# ==========================================
# Environment
# ==========================================
# Options: development, production, test
NODE_ENV=development

# ==========================================
# Feature Flags (Optional)
# ==========================================
# Enable/disable features during development
FEATURE_AI_ASSISTANT=true
FEATURE_GAMIFICATION=true
FEATURE_FORUM=true
FEATURE_LIVE_CLASSES=false

# ==========================================
# Rate Limiting (Optional)
# ==========================================
# Requests per hour
RATE_LIMIT_AUTHENTICATED=1000
RATE_LIMIT_ANONYMOUS=100
RATE_LIMIT_AI=20

# ==========================================
# Security
# ==========================================
# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ==========================================
# Development Tools
# ==========================================
# Show detailed errors in development
SHOW_STACK_TRACES=true

# Enable database query logging
LOG_QUERIES=false

# Enable performance monitoring
ENABLE_PERFORMANCE_MONITORING=false
